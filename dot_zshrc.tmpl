  issues=("${(@f)$(gh issue list --limit 100 --json number,title,author --template '{{ "{{" }}range .{{ "}}" }}{{ "{{" }}.number{{ "}}" }}[{{ "{{" }}.title{{ "}}" }}] {{ "{{" }}.title{{ "}}" }} ({{ "{{" }}.author.login{{ "}}" }}){{ "{{" }}"\n"{{ "}}" }}{{ "{{" }}end{{ "}}" }}' 2>/dev/null)}")
