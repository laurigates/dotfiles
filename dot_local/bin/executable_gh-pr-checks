#!/usr/bin/env bash
# gh-pr-checks — CI check detail for one PR, sized for an fzf preview pane.
# Used by the ghm / ghrp picker (private_dot_config/zsh/gh-wrappers.zsh).
#
#   gh-pr-checks summary <pr>   non-passing checks first (failed, cancelled,
#                               pending, skipped) with their descriptions,
#                               then one "N passed" line
#   gh-pr-checks logs <pr>      for each failed GitHub Actions job, the lines of
#                               its log (gh run view --log-failed) ending at the
#                               last ##[error]; other failed checks get their link
#
# <pr> may carry the picker's "#" prefix. GH_PR_CHECKS_LOG_LINES sets the
# excerpt length per job (default 40).
set -uo pipefail

usage() { echo "usage: gh-pr-checks summary|logs <pr>" >&2; exit 2; }
[[ $# -eq 2 ]] || usage
mode=$1 pr=${2#\#}
lines=${GH_PR_CHECKS_LOG_LINES:-40}

red=$'\e[31m' green=$'\e[32m' yellow=$'\e[33m' dim=$'\e[2m' bold=$'\e[1m' rst=$'\e[0m'

# gh pr checks exits 1 (failing) or 8 (pending) while still printing the JSON,
# so its exit status is not a failure signal here; empty output is.
checks() { gh pr checks "$pr" --json name,workflow,bucket,description,link --jq "$1" 2>/dev/null; }

summary() {
  local rows
  rows=$(checks '
    def rank: {fail: 0, cancel: 1, pending: 2, skipping: 3, pass: 4}[.bucket] // 5;
    sort_by(rank) | .[] |
    [.bucket, (if (.workflow // "") != "" then .workflow + " / " else "" end) + .name, (.description // "")] | @tsv')
  if [[ -z "$rows" ]]; then
    echo "${dim}no checks reported${rst}"
    return 0
  fi
  local bucket name desc passed=0 glyph
  while IFS=$'\t' read -r bucket name desc; do
    case $bucket in
      pass)     passed=$((passed + 1)); continue ;;
      fail)     glyph="${red}✗" ;;
      cancel)   glyph="${red}⊘" ;;
      pending)  glyph="${yellow}⏳" ;;
      skipping) glyph="${dim}-" ;;
      *)        glyph="?" ;;
    esac
    echo "${glyph} ${name}${rst}"
    [[ -n "$desc" ]] && echo "    ${dim}${desc}${rst}"
  done <<<"$rows"
  ((passed > 0)) && echo "${green}✓ ${passed} passed${rst}"
  return 0
}

logs() {
  local rows
  rows=$(checks '.[] | select(.bucket == "fail") | [(if (.workflow // "") != "" then .workflow + " / " else "" end) + .name, .link] | @tsv')
  if [[ -z "$rows" ]]; then
    echo "${dim}no failed checks${rst}"
    return 0
  fi
  local name link job log
  while IFS=$'\t' read -r name link; do
    echo "${bold}${red}✗ ${name}${rst}"
    if [[ $link =~ /actions/runs/[0-9]+/job/([0-9]+) ]]; then
      job=${BASH_REMATCH[1]}
      # --log-failed lines are "job<TAB>step<TAB>timestamp message"; keep the
      # message so the pane's width goes to the error text.
      log=$(gh run view --job "$job" --log-failed 2>&1)
      if [[ -n "$log" ]]; then
        # The log runs on past the failure into post-job cleanup, so end the
        # excerpt at the last "##[error]" line; with none, take the tail.
        cut -f3- <<<"$log" |
          sed -E 's/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z //' |
          awk -v n="$lines" -v red="$red" -v rst="$rst" '
            { line[NR] = $0; if (index($0, "##[error]")) last = NR }
            END {
              end = last ? last : NR; start = end - n + 1; if (start < 1) start = 1
              for (i = start; i <= end; i++)
                print (index(line[i], "##[error]") ? red line[i] rst : line[i])
            }'
      else
        echo "${dim}(no failed-step log available yet)${rst}"
      fi
    else
      echo "${dim}${link:-no link}${rst}"
    fi
    echo
  done <<<"$rows"
}

case $mode in
  summary) summary ;;
  logs)    logs ;;
  *)       usage ;;
esac
