{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':semanticCommits',
    ':semanticCommitTypeAll(chore)',
    'group:allNonMajor',
    // The account-wide runner starts twice a day, hours after its cron time.
    // `schedule:weekly` (Monday 00:00-03:59) caught none of those starts;
    // a whole-day weekend window catches several each week.
    'schedule:weekends',
  ],
  description: 'Renovate configuration for dotfiles repository',
  labels: [
    'dependencies',
    'renovate',
  ],
  prHourlyLimit: 2,
  prConcurrentLimit: 5,
  automerge: true,
  automergeType: 'pr',
  automergeStrategy: 'squash',
  platformAutomerge: true,
  packageRules: [
    {
      description: 'Automerge patch and minor updates',
      matchUpdateTypes: [
        'patch',
        'minor',
      ],
      automerge: true,
    },
    {
      description: 'Do not automerge major updates',
      matchUpdateTypes: [
        'major',
      ],
      automerge: false,
    },
    {
      description: 'Group GitHub Actions updates',
      matchManagers: [
        'github-actions',
      ],
      groupName: 'GitHub Actions',
      groupSlug: 'github-actions',
    },
    {
      description: 'Homebrew/actions pin: owned by the custom.regex manager below, not github-actions, which reads the pin comment "2026.09.21.1" as 2026.09.21 and can neither look it up nor rewrite it (#446)',
      matchManagers: [
        'github-actions',
      ],
      matchDepNames: [
        'Homebrew/actions',
      ],
      enabled: false,
    },
    {
      description: 'Keep the custom.regex Homebrew/actions pin in the GitHub Actions group (#446)',
      matchManagers: [
        'custom.regex',
      ],
      matchDepNames: [
        'Homebrew/actions',
      ],
      groupName: 'GitHub Actions',
      groupSlug: 'github-actions',
    },
    {
      description: 'Group pre-commit hooks updates',
      matchManagers: [
        'pre-commit',
      ],
      groupName: 'pre-commit hooks',
      groupSlug: 'pre-commit',
    },
    {
      description: 'chezmoi pin in .mise.toml: its own PR, never automerged (2.72.0 was a minor release that broke main, #418)',
      matchManagers: [
        'mise',
      ],
      matchDepNames: [
        'chezmoi',
      ],
      groupName: 'chezmoi',
      groupSlug: 'chezmoi',
      automerge: false,
    },
    {
      description: 'Group chezmoi external dependencies',
      matchManagers: [
        'custom.regex',
      ],
      matchFileNames: [
        '.chezmoiexternal.toml',
      ],
      groupName: 'chezmoi externals',
      groupSlug: 'chezmoi-externals',
    },
    {
      description: 'Pin GitHub Actions to digest for security',
      matchManagers: [
        'github-actions',
      ],
      pinDigests: true,
    },
  ],
  enabledManagers: [
    'github-actions',
    'pre-commit',
    'custom.regex',
    'mise',
  ],
  'github-actions': {
    managerFilePatterns: [
      '/^\\.github/workflows/[^/]+\\.ya?ml$/',
    ],
  },
  'pre-commit': {
    enabled: true,
  },
  customManagers: [
    {
      customType: 'regex',
      description: 'Update git repos in .chezmoiexternal.toml',
      managerFilePatterns: [
        '/^\\.chezmoiexternal\\.toml$/',
      ],
      matchStrings: [
        'url\\s*=\\s*"https://github\\.com/(?<depName>[^"]+?)(?:\\.git)?"\\s*[\\s\\S]*?(?:ref|tag|branch)\\s*=\\s*"(?<currentValue>[^"]+)"',
      ],
      datasourceTemplate: 'github-releases',
      versioningTemplate: 'semver',
    },
    {
      customType: 'regex',
      description: 'Update git repos (without explicit version) in .chezmoiexternal.toml - track latest releases',
      managerFilePatterns: [
        '/^\\.chezmoiexternal\\.toml$/',
      ],
      matchStrings: [
        '\\["(?<path>[^"]+)"\\]\\s*\\n\\s*type\\s*=\\s*"git-repo"\\s*\\n\\s*url\\s*=\\s*"https://github\\.com/(?<depName>[^/]+/[^"]+?)(?:\\.git)?"',
      ],
      datasourceTemplate: 'github-tags',
      depNameTemplate: '{{{depName}}}',
      currentValueTemplate: 'main',
      versioningTemplate: 'loose',
    },
    {
      customType: 'regex',
      description: 'Update the Homebrew/actions SHA pin in workflows. Its tags are YYYY.MM.DD.N and the github-actions manager keeps only three numeric components of the pin comment, so the comment must stay the bare tag (#446)',
      managerFilePatterns: [
        '/^\\.github/workflows/[^/]+\\.ya?ml$/',
      ],
      matchStrings: [
        'uses:[ \\t]*["\']?Homebrew/actions(?:/[\\w./-]+)?@(?<currentDigest>[a-f0-9]{40})["\']?[ \\t]+#[ \\t]*(?<currentValue>\\d+\\.\\d+\\.\\d+(?:\\.\\d+)?)',
      ],
      depNameTemplate: 'Homebrew/actions',
      datasourceTemplate: 'github-tags',
      versioningTemplate: 'regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:\\.(?<build>\\d+))?$',
    },
  ],
  commitMessagePrefix: 'chore(deps):',
  commitMessageAction: 'update',
  commitMessageTopic: '{{depName}}',
  prBodyTemplate: '{{{header}}}{{{table}}}{{{warnings}}}{{{notes}}}{{{changelogs}}}{{{controls}}}{{{footer}}}',
  vulnerabilityAlerts: {
    enabled: true,
    labels: [
      'security',
    ],
  },
  timezone: 'Europe/Helsinki',
}
