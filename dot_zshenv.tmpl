# Remove duplicates from path
typeset -U PATH path
# https://stackoverflow.com/a/18077919
# > # append
# > path+=('/home/david/pear/bin')
# > # or prepend
# > path=('/home/david/pear/bin' $path)
# > # export to sub-processes (make it inherited by child processes)
# > export PATH
# https://gist.github.com/Linerre/f11ad4a6a934dcf01ee8415c9457e7b2
path+="$HOME/.local/bin"
path+="/Applications/Obsidian.app/Contents/MacOS"

# Homebrew, for NON-interactive zsh (`ssh host cmd`, scripts), which reads only
# this file. Interactive shells get it again from .zshrc: on macOS a login shell
# runs /etc/zprofile after this file, and its path_helper moves everything set
# here behind /usr/bin (the gist above), so .zshrc re-prepends brew afterwards.
{{- if eq .chezmoi.os "darwin" }}
[ -x /opt/homebrew/bin/brew ] && path=("/opt/homebrew/bin" "/opt/homebrew/sbin" $path)
{{- else if eq .chezmoi.os "linux" }}
[ -x /home/linuxbrew/.linuxbrew/bin/brew ] && path=("/home/linuxbrew/.linuxbrew/bin" "/home/linuxbrew/.linuxbrew/sbin" $path)
{{- end }}

export PATH

source ~/.api_tokens

export OLLAMA_KEEP_ALIVE=30m

# rustup toolchain. mise's rust install is a symlink to ~/.cargo/bin, so
# `mise activate` (in .zshrc) already covers interactive shells. This covers
# NON-interactive zsh, where only .zshenv is sourced and nothing else supplies
# cargo/rustc/rustup/rust-analyzer — brew carries no rust. Guarded so a machine
# without rustup doesn't error at startup.
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

{{- if and (eq .chezmoi.os "linux") (.chezmoi.kernel.osrelease | contains "truenas") }}
# TrueNAS: /tmp is mounted noexec, breaking chezmoi's run_* scripts.
# Redirect TMPDIR to an exec-allowed dataset.
export TMPDIR="$HOME/tmp"
[ -d "$TMPDIR" ] || mkdir -p "$TMPDIR"
{{- end }}

{{- if eq .chezmoi.hostname "pop-os" }}
# popos: / has ~6 GB free. Apptainer defaults its layer cache to ~/.apptainer/cache
# and SIF assembly to /tmp, so keep both on the data disk.
export APPTAINER_CACHEDIR=/mnt/sabrent/apptainer/cache APPTAINER_TMPDIR=/mnt/sabrent/apptainer/tmp
[ -d "$APPTAINER_TMPDIR" ] || mkdir -p "$APPTAINER_CACHEDIR" "$APPTAINER_TMPDIR"
{{- end }}
# vim:ft=sh
